# Enterprise Website - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Django core settings
DEBUG=True
SECRET_KEY=django-insecure-enter-a-strong-secret-key-here-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.4

# Database configuration
# Set USE_SQLITE=True to easily run out-of-the-box on Windows/Linux/Mac without MySQL installed
USE_SQLITE=True

# If USE_SQLITE=False, the following MySQL/PostgreSQL parameters will be used:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=enterprise_db
DB_USER=enterprise_user
DB_PASSWORD=enterprise_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Channels (Required for containerized or distributed WebSocket/Async tasks)
REDIS_URL=redis://127.0.0.1:6379/0

# Production Security & SSL Configuration (Applied when DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Geodata Download Configuration
GEODATA_DOWNLOAD_URL=https://raw.githubusercontent.com/prograhammer/countries-regions-cities/master/world.sql

# API Keys & Third-Party Services
YANDEX_TRANSLATE_KEY=
DEEPL_AUTH_KEY=
OPENAI_API_KEY=
AZURE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS_PATH=

# Celery & Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
FLOWER_PORT=5555

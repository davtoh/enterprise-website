# ==============================================================================
# Nginx Reverse Proxy & Static File Server Configuration Template
# Parameterized via Docker envsubst at container startup (/etc/nginx/templates/)
# ==============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    client_max_body_size 25M;

    # Gzip Compression
    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;

    # Security Headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy "same-origin" always;

    # Static files served directly by Nginx
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Media uploads served directly by Nginx (matching MEDIA_URL = /media-files/)
    location /media-files/ {
        alias /app/media/;
        expires 7d;
        access_log off;
        add_header Cache-Control "public, max-age=604800";
    }

    # Dynamic DNS resolver using parameter or Docker embedded default (127.0.0.11)
    resolver ${DNS_RESOLVER} valid=5s ipv6=off;

    # Dynamic and WebSocket requests forwarded to ASGI/WSGI application
    location / {
        set $upstream_backend http://${WEB_HOST}:${WEB_PORT};
        proxy_pass $upstream_backend;
        proxy_http_version 1.1;

        # WebSocket headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Standard proxy headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_redirect off;
        proxy_read_timeout 86400; # Support long-lived WebSocket connections
    }
}

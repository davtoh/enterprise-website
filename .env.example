# Enterprise Website - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Django core settings
DEBUG=True
SECRET_KEY=django-insecure-enter-a-strong-secret-key-here-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.4

# Database configuration
# Set USE_SQLITE=True to easily run out-of-the-box on Windows/Linux/Mac without MySQL installed
USE_SQLITE=True

# If USE_SQLITE=False, the following MySQL/PostgreSQL parameters will be used:
DB_ENGINE=django.db.backends.mysql
DB_NAME=productsDB
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# API Keys & Third-Party Services
YANDEX_TRANSLATE_KEY=

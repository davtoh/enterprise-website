# ==============================================================================
# Local Development Overrides for Docker Compose (Template)
# Copy to `docker-compose.override.yml` for local developer host port bindings,
# hot-reloading mounts, and development debug mode.
# ==============================================================================

services:
  web:
    environment:
      - DEBUG=True
      - USE_SQLITE=True
      - DJANGO_LOG_LEVEL=DEBUG
    volumes:
      - .:/app
    ports:
      - "8000:8000"
    command: python manage.py runserver 0.0.0.0:8000

  celery_worker:
    environment:
      - DEBUG=True
      - USE_SQLITE=True
      - DJANGO_LOG_LEVEL=DEBUG
    volumes:
      - .:/app

  redis:
    ports:
      - "${REDIS_PORT:-6379}:6379"

  # Uncomment if you want to connect external DB GUI tools (e.g. DBeaver) to the PostgreSQL container
  # db:
  #   ports:
  #     - "${POSTGRES_PORT:-5432}:5432"
